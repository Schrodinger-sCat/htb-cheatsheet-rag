# ─────────────────────────────────────────────────────────────────────────
# HTB Cheatsheet Assistant — configuration
# Copy this file to `.env` and edit. The app loads `.env` automatically.
#   cp .env.example .env
# Real environment variables (if set) override values here.
# ─────────────────────────────────────────────────────────────────────────

# ── ChromaDB (the vector store) ──────────────────────────────────────────
# Leave RAG_CHROMA_HOST blank to run Chroma EMBEDDED (in-process, stored on
# local disk at data/index/chroma/). No server needed.
#
# To connect to YOUR OWN standalone ChromaDB server instead, set the host/port
# below. The app will store and search vectors on that server.
#   Start one with:  chroma run --host 0.0.0.0 --port 8001 --path ./chroma-data
RAG_CHROMA_HOST=
RAG_CHROMA_PORT=8000
RAG_CHROMA_SSL=0

# ── Ollama (embeddings + the LLM) ────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
RAG_LLM_MODEL=llama3.2:latest
RAG_EMBED_MODEL=all-minilm

# ── Retrieval ────────────────────────────────────────────────────────────
RAG_TOP_K=8

# ── Paths (usually leave as-is) ──────────────────────────────────────────
# RAG_RAW_DIR=data/raw
# RAG_INDEX_DIR=data/index
